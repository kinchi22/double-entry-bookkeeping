# Copy to `.env`. `.env` is gitignored -- never commit real credentials.
#
# One file, two readers:
#   - docker compose interpolates ${...} below when starting local Postgres
#   - pnpm scripts load it via node --env-file-if-exists, so DATABASE_URL
#     reaches next dev and drizzle-kit
#
# DATABASE_URL is spelled out rather than composed, because compose cannot
# build it from the parts. If you change a credential, change it in both places.

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=bookkeeping
POSTGRES_PORT=5433

DATABASE_URL=postgresql://app:app@localhost:5433/bookkeeping

# Sign-in (ADR-0021). The placeholders let `pnpm dev` start and sign in through
# the test sign-in, which AUTH_TEST_LOGIN turns on. To try Google itself, put a
# real OAuth client here whose redirect URIs include
# http://localhost:3000/auth/callback/google.
GOOGLE_CLIENT_ID=local-placeholder
GOOGLE_CLIENT_SECRET=local-placeholder
AUTH_TEST_LOGIN=1
