# Grouped by what writes the file. Anything a tool generates that must still
# survive review is listed at the bottom rather than here.

# Dependencies
node_modules/

# Build output
.next/
out/
dist/
build/
*.tsbuildinfo
# Rewritten by every `next dev` and `next build`, and the two write different
# contents, so a tracked copy dirties the tree depending on which ran last.
# Nothing needs it before one of them runs: typecheck passes without it.
apps/web/next-env.d.ts

# Tool caches
.turbo/

# Test, mutation and analysis reports
coverage/
reports/
playwright-report/
blob-report/
test-results/

# Scratch space for the gate-liveness scripts in tools/.
# Each is planted, checked, and deleted again in a finally block, so these
# entries only matter for a run that was killed before that block ran. The
# server-only probe is a page: left behind it breaks the next build, which is
# loud. Committing it would be quiet, and quiet is the worse failure.
.stryker-tmp/
.stryker-tmp-fixture/
.next-server-only-probe/
apps/web/app/(app)/server-only-probe/

# Agent scratch space. A Task is built in a `git worktree` of its own when the
# primary tree is busy, and it goes here whichever harness made it. It holds a
# full checkout and its own node_modules, it is deleted once the Task's pull
# request merges, and nothing in it is ever the source of a change: the branch
# is on the remote before the worktree goes.
.agents/worktrees/

# Secrets and per-machine configuration
.env
.env.*
!.env.example
.vercel/
.claude/settings.local.json
CLAUDE.local.md
# Codex reads an override *instead of* the AGENTS.md in the same directory
# rather than as well as it, so a root one would discard every rule in the
# working agreement while reading like a file of extra notes. Personal
# instructions belong in ~/.codex/AGENTS.md, outside the repository. ADR-0022.
AGENTS.override.md
# Per-machine Codex configuration. Nothing here is committed: an approval or
# sandbox stance is a decision of its own, not a side effect of parity.
.codex/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Deliberately NOT ignored, though a tool writes them:
#
#   packages/db/drizzle/    drizzle-kit generates it, but it is the migration
#                           ledger. Ignoring it would throw away the record of
#                           what has been applied to a database.
#   .env.example            matches `.env.*` above, so it is un-ignored there.
#   .claude/settings.json   shared project settings. Only the settings.local.json
#                           beside it is per-machine.
