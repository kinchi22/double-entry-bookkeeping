# Normalize all text files to LF in the repository and in the working tree.
* text=auto eol=lf

# Lockfile: generated, never hand-merged.
pnpm-lock.yaml linguist-generated=true

# Binary assets: never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
